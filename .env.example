# ---------------------------------------------------------------
# Pick ONE provider, paste its key, delete or ignore the others.
# NOVEM uses whichever key it finds. All three options below work.
# ---------------------------------------------------------------

# OPTION 1 — Groq. Free, no card needed, fastest. Recommended.
# Key from https://console.groq.com  ->  API Keys
GROQ_API_KEY=
# If this model name is rejected, copy a current one from the Groq console.
GROQ_MODEL=llama-3.3-70b-versatile

# OPTION 2 — Google Gemini. Free, no card needed.
# Key from https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OPTION 3 — Anthropic. Paid, requires billing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: force one provider when you have more than one key set.
# PROVIDER=groq

PORT=5174
